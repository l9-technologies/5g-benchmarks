@@ -44,6 +44,28 @@
 #include "iperf_time.h"
 #include "net.h"
 #include "timer.h"
+#include <time.h>
+
+/* Record timer boundaries only when the benchmark requests a sidecar. */
+static void
+benchmark_phase_event(const char *event)
+{
+    const char *path = getenv("BENCH_PHASE_EVENTS");
+    struct timespec before, epoch, after;
+    FILE *output;
+    if (path == NULL) return;
+    if (clock_gettime(CLOCK_MONOTONIC, &before) != 0 ||
+        clock_gettime(CLOCK_REALTIME, &epoch) != 0 ||
+        clock_gettime(CLOCK_MONOTONIC, &after) != 0) return;
+    output = fopen(path, "a");
+    if (output == NULL) return;
+    fprintf(output, "{\"event\":\"%s\",\"epoch_ns\":%lld,\"monotonic_before_ns\":%lld,\"monotonic_after_ns\":%lld}\n",
+            event, (long long)epoch.tv_sec * 1000000000LL + epoch.tv_nsec,
+            (long long)before.tv_sec * 1000000000LL + before.tv_nsec,
+            (long long)after.tv_sec * 1000000000LL + after.tv_nsec);
+    fclose(output);
+}
+
 
