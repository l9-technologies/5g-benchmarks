{
  "schema_version": 1,
  "name": "mini-buyer-traffic-and-devices",
  "cores": [
    "1sc",
    "open5gs",
    "free5gc",
    "ella",
    "qcore"
  ],
  "repetitions": 10,
  "seed": 1729,
  "equivalence_percent": 5,
  "timeout_seconds": 600,
  "required_features": [
    "registration",
    "pdu_session"
  ],
  "defaults": {
    "resource_accounting": "selected-core-processes",
    "cpu_clock": "process-nanoseconds",
    "duration_seconds": 30,
    "warmup_seconds": 5,
    "packet_bytes": 1200,
    "offered_mbps_per_ue": 1,
    "traffic_modes": [
      "udp_ul",
      "udp_dl"
    ],
    "probe_interval_seconds": 0.2,
    "resource_sample_seconds": 0.1,
    "load_tolerance_percent": 5,
    "probe_timestamp_precision": "nano",
    "user_plane": "linux-gtp",
    "readiness_timeout_seconds": 2
  },
  "cases": [
    {
      "id": "devices",
      "ue_counts": [
        1,
        10,
        50
      ],
      "idle_seconds": 30,
      "metrics": [
        "attach_success_percent",
        "registration_success_percent",
        "session_success_percent",
        "registration_attempted_ues",
        "registration_successful_ues",
        "registration_rejected_ues",
        "registration_pending_ues",
